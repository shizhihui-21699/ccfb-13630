{
  "name": "graphql-cost-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-execution GraphQL query cost analysis gateway with caller quotas and an audit dashboard",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:upstream": "tsx watch src/server/upstream.ts",
    "dev:gateway": "tsx watch src/server/gateway.ts",
    "dev": "concurrently -n upstream,gateway -c blue,green \"npm:dev:upstream\" \"npm:dev:gateway\"",
    "start:upstream": "tsx src/server/upstream.ts",
    "start:gateway": "tsx src/server/gateway.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "graphql": "^16.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
